[Unit]
Description=CITADEL
Requires=persistainer.service
After=network.target persistainer.service

[Service]
Type=simple
WorkingDirectory=/opt/safrano9999/CITADEL
PassEnvironment=CITADEL_WEBUI_PORT CITADEL_SUBNET_IP CITADEL_TAILSCALE CITADEL_CLOUDFLARE CITADEL_CLOUDFLARE_DOMAIN CITADEL_CLOUDFLARE_ACCOUNT_ID CITADEL_CLOUDFLARE_ZONE_ID CITADEL_CLOUDFLARE_TUNNEL_ID CITADEL_CLOUDFLARE_ORIGIN_HOST CLOUDFLARE_API_TOKEN CLOUDFLARE_EMAIL TUNNEL_TOKEN TS_STATE_DIR TS_AUTHKEY TS_HOSTNAME FASTAPI_HOST CODEANALYST_PORT JUGO_PORT USE_TMUX TMUX_SHELL JUGO_TMUX_SESSION_PREFIX DB_TYPE DB_PATH DB_URL DB_PORT DB_NAME_JUGO DB_USER_JUGO DB_PW_JUGO DEEPL_API_KEY XAI_API_KEY OPENAI_API_KEY GEMINI_API_KEY ELEVENLABS_API_KEY GOOGLE_TTS_CREDENTIALS OPENAI_V1_PROVIDER OPENAI_V1_URL OPENAI_V1_PORT OPENAI_V1_KEY OPENAI_V1_STREAM BIP39_PORT CLAUDE_CODE_OAUTH_TOKEN
ExecStart=uvicorn webui:app --host 0.0.0.0 --port ${CITADEL_WEBUI_PORT}
ExecStartPost=/bin/bash -c 'exec /usr/local/libexec/fedora44-wait-ready --timeout 60 tcp 127.0.0.1 "$${CITADEL_WEBUI_PORT}"'
Restart=on-failure

[Install]
WantedBy=multi-user.target
