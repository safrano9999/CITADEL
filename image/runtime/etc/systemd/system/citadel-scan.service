[Unit]
Description=CITADEL initial scan
Wants=network-online.target
After=network-online.target
After=persistainer.service fedora44-ai-init-hooks.service
After=bip39.service cloudflared.service cockpit.service
After=tailscaled.service tailscale-up.service
After=vditor-notes.service
After=hermes-ephemeral.service hermes.service hermes-dashboard.service
After=openclaw-config.service vikai-bootstrap-openclaw-agents.service openclaw.service
After=citadel.service codeanalyst.service
After=kachelmann-webui.service kachelmann-mcp.service
After=jugo.service kiwix-bridge.service
After=napoleon.service naturalgrounding.service
After=pvdach.service pvdach-qgis-webhook.service spanker-webui.service

[Service]
Type=oneshot
WorkingDirectory=/opt/safrano9999/CITADEL
PassEnvironment=CITADEL_WEBUI_PORT CITADEL_SUBNET_IP CITADEL_HTTPS_ONLY CITADEL_TAILSCALE CITADEL_TAILSCALE_DEFAULT CITADEL_TAILSCALE_HTTP_START CITADEL_TAILSCALE_HTTPS_START CITADEL_TAILSCALE_RANGE CITADEL_CLOUDFLARE CITADEL_CLOUDFLARE_DOMAIN CITADEL_CLOUDFLARE_ACCOUNT_ID CITADEL_CLOUDFLARE_ZONE_ID CITADEL_CLOUDFLARE_TUNNEL_ID CITADEL_CLOUDFLARE_ORIGIN_HOST CLOUDFLARE_API_TOKEN CLOUDFLARE_EMAIL TUNNEL_TOKEN TS_STATE_DIR TS_AUTHKEY TS_HOSTNAME FASTAPI_HOST CODEANALYST_PORT JUGO_PORT USE_TMUX TMUX_SHELL JUGO_TMUX_SESSION_PREFIX DB_TYPE DB_PATH DB_URL DB_PORT DB_NAME_JUGO DB_USER_JUGO DB_PW_JUGO DEEPL_API_KEY XAI_API_KEY OPENAI_API_KEY GEMINI_API_KEY ELEVENLABS_API_KEY GOOGLE_TTS_CREDENTIALS OPENAI_V1_PROVIDER OPENAI_V1_URL OPENAI_V1_PORT OPENAI_V1_KEY OPENAI_V1_STREAM BIP39_PORT HERMES_DASHBOARD_PORT HERMES_API_SERVER_PORT OPENCLAW_GATEWAY_PORT CLAUDE_CODE_OAUTH_TOKEN
ExecStart=/bin/bash scan.sh
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
