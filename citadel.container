# Generated by config.sh for CITADEL
# Edit config.conf, then run ./config.sh again.

[Container]
ContainerName=citadel
# Container image from config or existing generated file
Image=localhost/citadel:latest
# Runtime configuration files generated from *example files
EnvironmentFile=/home/openclaw/safcontainer/CITADEL/config.conf
EnvironmentFile=/home/openclaw/safcontainer/CITADEL/container.conf
EnvironmentFile=/home/openclaw/safcontainer/CITADEL/.env
# Port mappings: publish host:PUBLISH_PORT:PORT from config.conf/container.conf
PublishPort=127.0.0.1:10999:11999
# Container-internal bind address; published host is controlled by config
Exec=uvicorn webui:app --host 0.0.0.0 --port 11999
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=30

[Install]
WantedBy=default.target
