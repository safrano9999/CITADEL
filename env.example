# Token protecting Cloudflare edits in the WebUI.
#required:
#secret
CITADEL_TOKEN=example: openssl rand -hex 32

#default-preset: insert later
#secret
CLOUDFLARE_API_TOKEN=

#default-preset: insert later
CLOUDFLARE_EMAIL=foo@bar.de

#default-preset: insert later
#secret
CLOUDFLARE_TUNNEL_TOKEN=

# Optional fixed API client bearer. Skip to use OAuth alone.
#secret
CITADEL_CLOUDFLARE_API_BEARER=example: openssl rand -hex 32

# Alpine client activation and first login; state persists in its own volume.
#secret
TS_AUTHKEY=
