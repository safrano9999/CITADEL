# API token scoped to the selected account, zone, Tunnel, DNS, and Access policies.
#default-preset: insert later
CLOUDFLARE_API_TOKEN=

# Default Cloudflare Access email whitelist for newly discovered routes.
#default-preset: insert later
CLOUDFLARE_EMAIL=foo@bar.de

# Connector token consumed by the separately managed cloudflared service.
#default-preset: insert later
TUNNEL_TOKEN=
