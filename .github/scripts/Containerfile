# syntax=docker/dockerfile:1.7
# Source of truth: SCRIPTS/githubactions. Generated copies are overwritten.
# Verified ensurepip seed only; the application remains pip-free.
FROM scratch AS python-trust
ADD --checksum=sha256:fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70 \
    https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl /pip-26.2.2-py3-none-any.whl

FROM docker.io/library/alpine:3.24.3@sha256:b3413572228e34bd1c9245f5565e6cd127005655e8a7899aef33d8e83255c9e6

ARG CLOUDFLARED_VERSION=2026.9.3
ARG CLOUDFLARED_SHA256=77e26d8d900e0b8469f416239d14b5f296525fdf79fee6f511ef55609e3fbac2

# Stable Alpine repositories only; system Python packages, no pip/venv/compiler.
RUN apk upgrade --no-cache \
 && apk add --no-cache \
      python3 py3-dotenv py3-fastapi py3-jinja2 uvicorn \
      py3-uvloop py3-httptools py3-watchfiles py3-websockets py3-yaml \
      bash coreutils findutils grep sed gawk curl jq iproute2-ss util-linux \
      'ca-certificates>=20261020-r0' 'ca-certificates-bundle>=20261020-r0' tini tailscale=1.98.10-r1 \
 && test "$(apk --print-arch)" = x86_64 \
 && curl --fail --location --retry 3 \
      "https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/cloudflared-linux-amd64" \
      -o /usr/local/bin/cloudflared \
 && echo "${CLOUDFLARED_SHA256}  /usr/local/bin/cloudflared" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/cloudflared \
 && cloudflared --version \
 && python3 -s -c 'import dotenv, fastapi, jinja2, uvicorn' \
 && python3 -s -c "import ssl; certs = ssl.create_default_context().get_ca_certs(); names = {v for c in certs for rdn in c['subject'] for k, v in rdn if k == 'commonName'}; assert len(certs) > 50; assert {'emSign ECC Root CA - G3', 'AAA Certificate Services', 'emSign Root CS CA - G3'}.isdisjoint(names)"

RUN --mount=type=bind,from=python-trust,target=/tmp/python-trust \
    python3 -c "import ensurepip, pathlib, shutil, sysconfig; seed = pathlib.Path(sysconfig.get_config_var('WHEEL_PKG_DIR') or pathlib.Path(ensurepip.__file__).with_name('_bundled')); [p.unlink() for p in seed.glob('pip-*.whl')]; shutil.copy('/tmp/python-trust/pip-26.2.2-py3-none-any.whl', seed); source = pathlib.Path(ensurepip.__file__); text = source.read_text(); old = ensurepip._PIP_VERSION; assert text.count(old) == 1; source.write_text(text.replace(old, '26.2.2')); ensurepip._PIP_VERSION = '26.2.2'; assert ensurepip.version() == '26.2.2'"

RUN python3 -c "import ensurepip; assert ensurepip.version() == '26.2.2'"

WORKDIR /opt/safrano9999/CITADEL
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 FASTAPI_HOST=0.0.0.0

# Source allowlist: no runtime configuration, credentials, cached scans or logos.
COPY webui.py python_header.py scan.sh unroute.sh requirements.txt config.conf_example config.ini.example env.example citadel.svg ./
COPY functions/*.py ./functions/
COPY functions/providers/*.py ./functions/providers/
COPY functions/exporters/*.py ./functions/exporters/
COPY workers/cloudflare-api/worker.mjs ./workers/cloudflare-api/
COPY CLOUDFLARE-API_ignore.json CLOUDFLARE-API_discovery.json.example CLOUDFLARE-API_access.json.example CLOUDFLARE_OAUTH_Whitelist.json.example ./
COPY extensions/disabled/CLOUDFLARE-API/extension.json ./extensions/disabled/CLOUDFLARE-API/
COPY assets/ ./assets/
COPY templates/ ./templates/
COPY extensions/ui.json ./extensions/
COPY extensions/enabled/caddy/extension.json ./extensions/enabled/caddy/
COPY extensions/enabled/cloudflare/extension.json extensions/enabled/cloudflare/config.json ./extensions/enabled/cloudflare/
COPY extensions/enabled/localhost/extension.json extensions/enabled/localhost/config.json ./extensions/enabled/localhost/
COPY extensions/enabled/subnet/extension.json extensions/enabled/subnet/config.json ./extensions/enabled/subnet/
COPY extensions/enabled/tailscale/extension.json extensions/enabled/tailscale/config.json ./extensions/enabled/tailscale/
COPY image/runtime/usr/local/bin/tailscale-serve-reset.sh /usr/local/bin/
COPY container/entrypoint.py /usr/local/bin/citadel-container

# Application code and runtime data are separate, without path aliases.
RUN mkdir -p extensions/disabled /run/citadel \
 && python3 -s functions/runtime_state.py --image \
 && chmod 0755 scan.sh unroute.sh /usr/local/bin/citadel-container /usr/local/bin/tailscale-serve-reset.sh

EXPOSE 11000
ENTRYPOINT ["/sbin/tini", "--", "/usr/bin/python3", "-s", "/usr/local/bin/citadel-container"]
