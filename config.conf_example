# Host bind address for direct run and published ports
HOST=127.0.0.1

# CITADEL FastAPI web UI internal port
CITADEL_WEBUI_PORT=10999

# CITADEL FastAPI web UI host port
CITADEL_WEBUI_PUBLISH_PORT=10999

# Host subnet IP used by CITADEL scans
CITADEL_SUBNET_IP=

# Map routes from an already logged-in host/container Tailscale daemon.
# CITADEL never starts or logs into Tailscale.
CITADEL_TAILSCALE=true
