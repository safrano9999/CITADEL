# WebUI transport is independent of the optional Caddyfile export.
#choices: tcp unix
CITADEL_WEBUI_TRANSPORT=tcp

# Unix transport only. Empty uses CITADEL_DATA/CADDY/citadel.sock,
# identically for the host service and container. Absolute overrides are optional.
#when: CITADEL_WEBUI_TRANSPORT=unix
CITADEL_WEBUI_SOCKET=

#publish-host: FASTAPI_HOST
#required: FastAPI bind host
FASTAPI_HOST=127.0.0.1

#required: CITADEL internal web UI port
CITADEL_WEBUI_PORT=11000

# Hide only this WebUI's duplicate HTTP tile while the same instance is
# reachable through a working scanned HTTPS frontend. Backends remain routable.
#choices: 0 1
#default-preset: 1
CITADEL_HIDE_HTTP_WEBUI_DUPE=1

# Optional Caddyfile export. Empty/0 disables generation, not the WebUI.
CADDYFILE_START=

# Empty/blank uses step 1 and rebuilds all assignments on every scan.
# An explicit positive number retains assigned frontend ports across scans.
CADDYFILE_STEPS=1

# Address of this instance as reachable FROM Caddy (hostname/IP, no scheme/port).
# Same host: 127.0.0.1; host via Podman: host.containers.internal;
# another container on Caddy's Podman network: that container's network name.
#default-preset: 127.0.0.1
CADDYFILE_BACKEND=127.0.0.1

# full: reset/rebuild same-port HTTPS Serve routes for all discovered services.
# http_to_https: keep verified direct HTTPS; use Serve only for HTTP backends.
# off: never manage Serve; advertise only verified direct HTTPS endpoints.
# Volumes/mounts are configured separately at the container level.
#choices: off http_to_https full
#default-preset: full
CITADEL_TAILSCALE_SERVE=full

# Bootstrap only: clear all Serve/Funnel routes after Tailscale up, before WebUI.
# Independent of the Citadel scan; only literal 1 enables the reset.
#choices: 0 1
#default-preset: 0
TAILSCALE_SERVE_RESET=0

# Empty uses the container hostname.
TS_HOSTNAME=
TS_EXTRA_ARGS=--ssh

# Kernel TUN by default; userspace mode needs no /dev/net/tun or NET_ADMIN.
#choices: 0 1
#default-preset: 0
TS_USERSPACE=0

# Keep downloaded logos between scans. Volume mounts are configured separately.
#choices: 0 1
#default-preset: 1
CITADEL_LOGO_PERSISTENT=1

# Optional: leave empty to disable subnet routes.
CITADEL_SUBNET_IP=

#choices: 0 1
#default-preset: 0
# HTTP services remain visible but are not exposed through providers when enabled.
CITADEL_HTTPS_ONLY=0

# Optional HTTP User-Agent for service discovery; leave empty to use curl's default.
#default-preset: Mozilla/5.0 (compatible; CITADEL/1.0)
CITADEL_USER_AGENT=Mozilla/5.0 (compatible; CITADEL/1.0)

# Keep unchanged Cloudflare-side DNS, Access and tunnel routes (no local volume).
# 0 deletes/rebuilds all managed bindings on every scan.
#choices: 0 1
#default-preset: 1
CITADEL_CLOUDFLARE_SERVERSIDE_PERSISTENCE=1

# OAuth for email entries in CLOUDFLARE-API_access.json. Bearer entries work independently.
# Client callbacks: CLOUDFLARE_OAUTH_Whitelist.json (copy the .json.example).
#choices: 0 1
#default-preset: 0
CITADEL_CLOUDFLARE_API_OAUTH=0
# Published authentication modes: both (default), bearer, or oauth.
# OAuth also requires CITADEL_CLOUDFLARE_API_OAUTH=1 and client callbacks.
#choices: both bearer oauth
#default-preset: both
CITADEL_CLOUDFLARE_API_MODE=both

#default-preset: insert later
CITADEL_CLOUDFLARE_DOMAIN=

# Port 443 hostname switches: www443 has priority in dashboard/provider links.
# Set either or both to 1; with both 0, CITADEL uses the numeric 443 hostname.
#default-preset: 0
CITADEL_CLOUDFLARE_WWW443=0
#default-preset: 0
CITADEL_CLOUDFLARE_DOMAIN443=0

# Redirect the bare domain to https://www.<domain> (301, path/query preserved).
# Requires WWW443=1, DOMAIN443=1 and Cloudflare Dynamic URL Redirects Edit.
# Set 0 to remove this tunnel's redirect; unrelated rules are preserved.
#default-preset: 0
CITADEL_CLOUDFLARE_REDIRECT_TO_WWW=0

#default-preset: insert later
CITADEL_CLOUDFLARE_ACCOUNT_ID=
#default-preset: insert later
CITADEL_CLOUDFLARE_ZONE_ID=
#default-preset: insert later
CITADEL_CLOUDFLARE_TUNNEL_ID=
