# Host bind address for the baremetal Web UI
HOST=127.0.0.1

# CITADEL FastAPI Web UI port
CITADEL_WEBUI_PORT=10999

# Host subnet IP used by CITADEL scans
CITADEL_SUBNET_IP=

# Map routes from an already logged-in host Tailscale daemon.
# CITADEL never starts or logs into Tailscale.
CITADEL_TAILSCALE=true

# Reconcile Cloudflare DNS, Tunnel ingress, and optional Access email policies.
# CITADEL never starts or authenticates cloudflared.
CITADEL_CLOUDFLARE=1

# Default suffix for generated hostnames. May be the zone itself or a subdomain.
CITADEL_CLOUDFLARE_DOMAIN=

# Cloudflare resources used by the deterministic API reconcile.
CITADEL_CLOUDFLARE_ACCOUNT_ID=
CITADEL_CLOUDFLARE_ZONE_ID=
CITADEL_CLOUDFLARE_TUNNEL_ID=

# Origin as seen by cloudflared. Keep 127.0.0.1 for baremetal or host networking.
CITADEL_CLOUDFLARE_ORIGIN_HOST=127.0.0.1

