[Unit]
Description=CITADEL dynamic Tailscale listener reconciliation
Wants=tailscale-up.service network-online.target
After=tailscale-up.service network-online.target citadel.service
ConditionPathExists=/opt/safrano9999/CITADEL/extensions/enabled/tailscale/extension.json

[Service]
Type=oneshot
WorkingDirectory=/opt/safrano9999/CITADEL
PassEnvironment=CITADEL_TAILSCALE CITADEL_SUBNET_IP FASTAPI_HOST
PassEnvironment=CITADEL_TAILSCALE_RESCAN_MAX_AGE CITADEL_TAILSCALE_RESCAN_STATE CITADEL_TAILSCALE_STATE_FILE
PassEnvironment=CITADEL_SCAN_SCRIPT CITADEL_SCAN_LOCK_FILE CITADEL_SCAN_LOCK_TIMEOUT
PassEnvironment=XDG_RUNTIME_DIR TMPDIR
ExecStart=/opt/safrano9999/CITADEL/tailscale-rescan.sh
TimeoutStartSec=900
